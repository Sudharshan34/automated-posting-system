# Copy to .env and fill in. Never commit .env.

# Mastodon  (Settings > Development > New application, scope: write:statuses)
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Bluesky  (Settings > App Passwords)
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=

# Dev.to  (Settings > Extensions > Generate API key)
DEVTO_API_KEY=

# Telegraph  (open in browser: https://api.telegra.ph/createAccount?short_name=poster&author_name=poster
#             and copy "access_token" from the JSON)
TELEGRAPH_ACCESS_TOKEN=

# GitHub Gist  (github.com/settings/tokens > Generate new token (classic) > tick only "gist")
GITHUB_TOKEN=

# Telegram  (create bot with @BotFather, add it as admin to a PUBLIC channel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@your_public_channel

# GitLab Snippets  (gitlab.com > Preferences > Access tokens > scope "api")
GITLAB_TOKEN=
